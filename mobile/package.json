{
  "name": "dominion-voice-mobile",
  "version": "0.4.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "apk": "expo prebuild --platform android --clean && cd android && ./gradlew :app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@livekit/react-native": "3.0.0",
    "@livekit/react-native-expo-plugin": "1.0.3",
    "@livekit/react-native-webrtc": "144.2.0",
    "@types/react": "19.2.4",
    "expo": "57.0.24",
    "livekit-client": "2.22.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "6.0.3",
    "expo-speech": "57.0.3",
    "expo-speech-recognition": "57.1.0",
    "expo-secure-store": "57.0.4",
    "expo-image-picker": "~57.0.0",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-notifications": "~57.0.25",
    "expo-contacts": "~57.0.9",
    "expo-calendar": "~57.0.7",
    "expo-crypto": "~57.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.0"
  },
  "overrides": {
    "@livekit/react-native-expo-plugin": {
      "@livekit/react-native": "$@livekit/react-native"
    }
  }
}
