{
  "expo": {
    "name": "DOMINION Assistant",
    "slug": "dominion-voice-mobile",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dominion.voice",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "도미니온 음성 대화에 마이크를 사용합니다.",
        "NSLocalNetworkUsageDescription": "같은 Wi-Fi의 도미니온 PC에 연결합니다.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.dominion.voice",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_LOCAL_NETWORK",
        "android.permission.CAMERA"
      ],
      "versionCode": 5,
      "blockedPermissions": []
    },
    "plugins": [
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      "expo-speech-recognition",
      "./withPersonalLan.js",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "비서에게 사진을 보내기 위해 사진을 선택합니다.",
          "cameraPermission": "비서에게 사진을 보내기 위해 카메라를 사용합니다.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-contacts",
        {
          "contactsPermission": "전화할 연락처를 직접 선택할 때만 사용합니다."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "사용자가 선택한 일정을 캘린더에 추가합니다."
        }
      ]
    ]
  }
}
